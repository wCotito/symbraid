{
  "name": "code-index",
  "displayName": "Code Index",
  "description": "Workspace-scoped semantic code indexing for LanceDB and Qdrant.",
  "version": "0.2.0",
  "publisher": "ada-b",
  "license": "MIT",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Other", "Machine Learning"],
  "activationEvents": ["onStartupFinished", "onCommand:codeIndex.manage"],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      { "command": "codeIndex.manage", "title": "%command.manage%" },
      { "command": "codeIndex.toggle", "title": "%command.toggle%" },
      { "command": "codeIndex.index", "title": "%command.index%" }
    ]
  },
  "scripts": {
    "test": "node test/core.test.js && node test/ui.test.js",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": { "@vscode/vsce": "^3.6.0" }
}
