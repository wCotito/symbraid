{
  "name": "symbraid",
  "displayName": "Symbraid",
  "description": "Workspace-scoped Symbraid watch integration.",
  "version": "0.3.0",
  "publisher": "symbraid",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wCotito/symbraid"
  },
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished", "onCommand:symbraid.manage", "onCommand:symbraid.toggle"],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      { "command": "symbraid.manage", "title": "%command.manage%" },
      { "command": "symbraid.toggle", "title": "%command.toggle%" }
    ],
    "configuration": {
      "title": "Symbraid",
      "properties": {
        "symbraid.executablePath": {
          "type": "string",
          "default": "",
          "description": "Path to the Symbraid executable. Leave empty to resolve symbraid from PATH."
        }
      }
    }
  },
  "scripts": {
    "test": "node test/extension.test.js && node test/ui.test.js",
    "package": "vsce package --no-dependencies --baseContentUrl https://github.com/wCotito/symbraid/blob/main/extensions/vscode-symbraid"
  },
  "devDependencies": { "@vscode/vsce": "^3.6.0" }
}
